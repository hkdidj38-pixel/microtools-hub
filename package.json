{
  "name": "microtools-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-meta.mjs && tsc && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "validate:meta": "node scripts/validate-meta.mjs",
    "test": "vitest run",
    "create-tool": "node scripts/create-tool.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --lib ES2022,DOM functions/api/screenshot.ts"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.4",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
